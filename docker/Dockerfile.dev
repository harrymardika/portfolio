# Development image: real Node.js for Astro (requires >= 22.12) plus Bun for packages and tests,
# matching the local setup. Source code is bind-mounted by docker/compose.dev.yml, not copied.
FROM node:22-bookworm-slim

# Bun version must match the one used to write bun.lock.
COPY --from=oven/bun:1.3.9 /usr/local/bin/bun /usr/local/bin/bun

ENV ASTRO_TELEMETRY_DISABLED=1
WORKDIR /app
EXPOSE 4321

# Install into the node_modules volume on every start (fast when nothing changed), then serve with HMR.
CMD ["sh", "-c", "bun install --frozen-lockfile && bun run dev --host 0.0.0.0 --port 4321"]
