# Copy to .env and fill in. Never commit .env.

# --- Site ---
SITE_URL=https://harry.mardika.my.id

# --- GitHub sync (Phase 3) ---
# Optional. Without it the public API allows 60 requests/hour, enough for builds.
# A fine-grained token with no extra permissions (public repos, read-only) raises the limit.
# Username, topic, and which repos to show live in content/github.yaml.
GITHUB_TOKEN=

# --- Built-in stats (Phase 5, docs/08-analytics.md) ---
# Include the page beacon in the build. Production: true. It never sends from localhost unless
# localStorage['stats:debug'] = '1' is set in the browser.
PUBLIC_STATS_ENABLED=false
# Token for the owner-only endpoint /api/stats/private (tracking links). Long random string,
# e.g. `openssl rand -hex 32`. The same value goes on the server and in your local .env.
STATS_ADMIN_TOKEN=
# Site queried by `bun run stats:report` (default https://harry.mardika.my.id).
STATS_URL=

# --- Cloudflare Tunnel (managed by the owner on the server) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Cloudflare cache purge on deploy (server only: /opt/portfolio/.env, ADR 0012) ---
# API token with only "Zone · Cache Purge · Purge" on the mardika.my.id zone; zone ID from the zone's Overview.
CF_API_TOKEN=
CF_ZONE_ID=
SITE_HOST=harry.mardika.my.id

# --- AI case study drafts (T8.2, ADR 0013); GitHub repository secrets in CI, optional locally for `bun run drafts --dry-run` ---
# Google AI Studio key (first choice) and Groq key (fallback).
GEMINI_API_KEY=
GROQ_API_KEY=
