# Copy to .env and fill in. Never commit .env.

# --- Site ---
SITE_URL=https://harry.mardika.my.id

# --- GitHub sync (Phase 3) ---
# Fine-grained token, read-only access to public repositories is enough.
GITHUB_TOKEN=
GITHUB_USERNAME=harrymardika
# Repos with this topic are shown as projects.
GITHUB_SHOWCASE_TOPIC=portfolio

# GitHub repos to show are chosen in content/github.yaml and/or with the topic below.

# --- Built-in stats (Phase 5, docs/08-analytics.md) ---
# Token for the owner-only endpoint /api/stats/private (tracking links). Long random string.
STATS_ADMIN_TOKEN=

# --- Cloudflare Tunnel (managed by the owner on the server) ---
CLOUDFLARE_TUNNEL_TOKEN=
