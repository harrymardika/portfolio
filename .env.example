# Copy to .env and fill in. Never commit .env.

# --- Site ---
SITE_URL=https://harry.mardika.my.id

# --- GitHub sync (Phase 3) ---
# Fine-grained token, read-only access to public repositories is enough.
GITHUB_TOKEN=
GITHUB_USERNAME=harrymardika
# Repos with this topic are shown as projects.
GITHUB_SHOWCASE_TOPIC=portfolio

# --- Analytics (Phase 5) ---
PUBLIC_UMAMI_SRC=https://analytics.mardika.my.id/script.js
PUBLIC_UMAMI_WEBSITE_ID=

# --- Umami server (docker/compose.yml, Phase 5) ---
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=

# --- Cloudflare Tunnel (managed by the owner on the server) ---
CLOUDFLARE_TUNNEL_TOKEN=
