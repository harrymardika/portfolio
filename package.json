{
  "name": "temporal-portal-portfolio",
  "version": "1.0.0",
  "description": "Temporal Portal / Time-Warp Portfolio - Interactive cinematic portfolio with GitHub integration",
  "author": "Harry Mardika",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run fetch-projects && tsc && vite build",
    "preview": "vite preview",
    "fetch-projects": "bun run scripts/fetch-github-projects.ts",
    "fetch-projects:force": "bun run scripts/fetch-github-projects.ts --force",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  }
}
