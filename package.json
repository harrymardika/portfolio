{
  "name": "harry-mardika-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Personal portfolio of Harry Mardika, self-hosted at harry.mardika.my.id",
  "author": "Harry Mardika",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "bun run fetch:github && astro dev",
    "build": "bun run fetch:github && astro build && bun run pdf && bun run og && bun run sitemap && bun run csp",
    "preview": "astro preview",
    "astro": "astro",
    "fetch:github": "bun scripts/fetch-github.ts",
    "pdf": "bun scripts/generate-pdf.ts",
    "og": "bun scripts/generate-og.ts",
    "sitemap": "bun scripts/generate-sitemap.ts",
    "csp": "bun scripts/generate-csp.ts",
    "stats:dev": "bun services/stats/server.ts",
    "stats:report": "bun scripts/stats-report.ts",
    "typecheck": "astro check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:tokens": "bun scripts/check-tokens.ts",
    "check": "bun run typecheck && bun run lint && bun run lint:tokens && bun run format:check",
    "test:unit": "bun test",
    "test:coverage": "bun test --coverage",
    "test:e2e": "playwright test",
    "lighthouse": "bunx @lhci/cli@0.15.1 autorun",
    "lighthouse:summary": "bun scripts/lighthouse-summary.ts",
    "drafts": "bun scripts/draft-case-studies.ts",
    "test:e2e:docker": "E2E_BASE_URL=http://localhost:${WEB_PORT:-8080} playwright test --project=desktop --grep-invert @fixture",
    "verify": "bun run check && bun test && bun run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/young-serif": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "js-yaml": "4.3.2",
    "tailwindcss": "4.3.3",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.13.0",
    "pdfjs-dist": "6.4.299",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
