---
/**
 * Standard page frame: skip link, header, main landmark, footer, and the "Ask Harry" chat (T11.4).
 * Pages pass the profile so the layout itself does not fetch data.
 */
import BaseLayout from './BaseLayout.astro';
import AskWidget from '@/components/assistant/AskWidget.astro';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import SkipLink from '@/components/layout/SkipLink.astro';

import type { Profile } from '@/lib/content';
import type { Locale } from '@/lib/i18n';
import type { JsonLd } from '@/lib/seo';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: JsonLd[];
  profile: Pick<Profile, 'name' | 'socials'>;
}

const { profile, ...base } = Astro.props;
// Built in only once the assistant service runs on the server (T11.6); before that its health check would 404.
const assistant = import.meta.env.PUBLIC_ASSISTANT_ENABLED === 'true';
---

<BaseLayout {...base}>
  <SkipLink locale={base.locale} />
  <Header locale={base.locale} siteName={profile.name} />
  <main id="main" tabindex="-1" class="focus:outline-none">
    <slot />
  </main>
  <Footer locale={base.locale} profile={profile} />
  {assistant && <AskWidget locale={base.locale} profile={profile} />}
</BaseLayout>
