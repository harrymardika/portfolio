---
/**
 * Shell for the print views that become PDFs (docs/09-pdf-generation.md): always light, no site
 * chrome, not indexed, no canonical/hreflang. Page size and margins come from the `size` prop.
 */
import BaseLayout from './BaseLayout.astro';

import type { Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
  title: string;
  size: 'portrait' | 'landscape';
}

const { locale, title, size } = Astro.props;
---

<BaseLayout locale={locale} title={title} noindex linkAlternates={false} forceTheme="light" track={false}>
  <div class:list={['print-root', size]}>
    <slot />
  </div>
</BaseLayout>

<style is:global>
  /* The PDF is generated by Chromium with preferCSSPageSize, so these rules define the paper. */
  @page {
    size: A4 portrait;
    margin: 10mm 11mm;
  }

  @page landscape {
    size: A4 landscape;
    margin: 0;
  }

  .print-root.landscape {
    page: landscape;
  }

  @media screen {
    /* On screen, show the document like a sheet of paper. */
    body:has(.print-root) {
      background: var(--line);
    }

    .print-root.portrait {
      max-width: 210mm;
      margin: 24px auto;
      padding: 10mm 11mm;
      background: var(--surface);
    }

    .print-root.landscape {
      max-width: 297mm;
      margin: 24px auto;
      background: var(--surface);
    }
  }

  @media print {
    body {
      background: var(--surface);
    }
  }
</style>
