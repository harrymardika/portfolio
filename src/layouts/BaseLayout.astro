---
/**
 * Document shell for every page: language, theme bootstrap, canonical URL, hreflang alternates,
 * and social/SEO meta. Page chrome (header, footer, skip link) lives in PageLayout.
 * Each indexable page gets its own social preview image (scripts/generate-og.ts) and optional
 * JSON-LD; the sitemap is built from these heads after the build (scripts/generate-sitemap.ts).
 */
import '@/styles/global.css';
import StatsBeacon from '@/components/layout/StatsBeacon.astro';
import { alternates, DEFAULT_LOCALE, LOCALE_TAGS, LOCALES, type Locale } from '@/lib/i18n';
import { DEFAULT_OG_IMAGE, type JsonLd, OG_HEIGHT, OG_WIDTH, ogImagePath, serializeJsonLd } from '@/lib/seo';
import { type RoomPoint, THEME_STORAGE_KEY, type Theme } from '@/lib/theme';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  /** Exclude utility pages (print views, placeholders) from search engines. */
  noindex?: boolean;
  /** Write canonical and hreflang links. Off for pages without a fixed URL, such as 404. */
  linkAlternates?: boolean;
  /** Pin the theme and ignore the visitor's choice (print pages are always light). */
  forceTheme?: Theme;
  /** Include the statistics beacon (off for print pages that become PDFs). */
  track?: boolean;
  /** Structured data for search engines (src/lib/seo/json-ld.ts). */
  jsonLd?: JsonLd[];
  /** The page's point in the room gradient (docs/03-design-system.md §2). */
  room?: RoomPoint;
  /** Print view: plain paper and the original palette, so the PDFs never change. */
  print?: boolean;
}

const {
  locale,
  title,
  description,
  noindex = false,
  linkAlternates = true,
  forceTheme,
  track = true,
  jsonLd = [],
  room = 'mid',
  print = false,
} = Astro.props;
const paths = alternates(Astro.url.pathname);
const absolute = (path: string): string => new URL(path, Astro.site).href;
const ogLocale = (value: Locale): string => LOCALE_TAGS[value].replace('-', '_');
// Indexable pages have their own preview image; utility pages share the home page's.
const ogImage = absolute(linkAlternates && !noindex ? ogImagePath(Astro.url.pathname) : DEFAULT_OG_IMAGE);
---

<!doctype html>
<html lang={LOCALE_TAGS[locale]} data-theme={forceTheme} data-print={print ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {!forceTheme && (
      <>
        <!-- Runs before first paint: marks JS as available and applies a stored theme without a flash. -->
        <script is:inline define:vars={{ storageKey: THEME_STORAGE_KEY }}>
          document.documentElement.classList.add('js');
          try {
            const stored = localStorage.getItem(storageKey);
            if (stored === 'light' || stored === 'dark') document.documentElement.dataset.theme = stored;
          } catch {
            /* Storage blocked: follow the OS theme. */
          }
        </script>
      </>
    )}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {linkAlternates && (
      <>
        <link rel="canonical" href={absolute(paths[locale])} />
        {LOCALES.map((alt) => (
          <link rel="alternate" hreflang={alt} href={absolute(paths[alt])} />
        ))}
        <link rel="alternate" hreflang="x-default" href={absolute(paths[DEFAULT_LOCALE])} />
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={absolute(paths[locale])} />
    <meta property="og:locale" content={ogLocale(locale)} />
    {LOCALES.filter((alt) => alt !== locale).map((alt) => (
      <meta property="og:locale:alternate" content={ogLocale(alt)} />
    ))}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((data) => (
      <script type="application/ld+json" is:inline set:html={serializeJsonLd(data)} />
    ))}
  </head>
  <body data-room={room}>
    <slot />
    {track && <StatsBeacon />}
  </body>
</html>
