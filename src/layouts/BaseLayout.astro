---
/**
 * Document shell for every page: language, theme bootstrap, canonical URL, hreflang alternates,
 * and social/SEO meta. Page chrome (header, footer, skip link) lives in PageLayout.
 * OG images, sitemap, and JSON-LD are added in T7.1.
 */
import '@/styles/global.css';
import { alternates, DEFAULT_LOCALE, LOCALE_TAGS, LOCALES, type Locale } from '@/lib/i18n';
import { THEME_STORAGE_KEY, type Theme } from '@/lib/theme';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  /** Exclude utility pages (print views, placeholders) from search engines. */
  noindex?: boolean;
  /** Write canonical and hreflang links. Off for pages without a fixed URL, such as 404. */
  linkAlternates?: boolean;
  /** Pin the theme and ignore the visitor's choice (print pages are always light). */
  forceTheme?: Theme;
}

const { locale, title, description, noindex = false, linkAlternates = true, forceTheme } = Astro.props;
const paths = alternates(Astro.url.pathname);
const absolute = (path: string): string => new URL(path, Astro.site).href;
const ogLocale = (value: Locale): string => LOCALE_TAGS[value].replace('-', '_');
---

<!doctype html>
<html lang={LOCALE_TAGS[locale]} data-theme={forceTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {!forceTheme && (
      <>
        <!-- Runs before first paint: marks JS as available and applies a stored theme without a flash. -->
        <script is:inline define:vars={{ storageKey: THEME_STORAGE_KEY }}>
          document.documentElement.classList.add('js');
          try {
            const stored = localStorage.getItem(storageKey);
            if (stored === 'light' || stored === 'dark') document.documentElement.dataset.theme = stored;
          } catch {
            /* Storage blocked: follow the OS theme. */
          }
        </script>
      </>
    )}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {linkAlternates && (
      <>
        <link rel="canonical" href={absolute(paths[locale])} />
        {LOCALES.map((alt) => (
          <link rel="alternate" hreflang={alt} href={absolute(paths[alt])} />
        ))}
        <link rel="alternate" hreflang="x-default" href={absolute(paths[DEFAULT_LOCALE])} />
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={absolute(paths[locale])} />
    <meta property="og:locale" content={ogLocale(locale)} />
    {LOCALES.filter((alt) => alt !== locale).map((alt) => (
      <meta property="og:locale:alternate" content={ogLocale(alt)} />
    ))}
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <slot />
  </body>
</html>
