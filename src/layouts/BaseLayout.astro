---
/**
 * Document shell for every page: language, canonical URL, and hreflang alternates.
 * Extended with header, footer, skip link, and SEO meta in T1.7.
 */
import { alternates, DEFAULT_LOCALE, LOCALE_TAGS, LOCALES, type Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  /** Exclude utility pages (print views, placeholders) from search engines. */
  noindex?: boolean;
}

const { locale, title, description, noindex = false } = Astro.props;
const paths = alternates(Astro.url.pathname);
const absolute = (path: string): string => new URL(path, Astro.site).href;
---

<!doctype html>
<html lang={LOCALE_TAGS[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={absolute(paths[locale])} />
    {LOCALES.map((alt) => (
      <link rel="alternate" hreflang={alt} href={absolute(paths[alt])} />
    ))}
    <link rel="alternate" hreflang="x-default" href={absolute(paths[DEFAULT_LOCALE])} />
  </head>
  <body>
    <slot />
  </body>
</html>
