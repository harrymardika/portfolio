---
/**
 * Site statistics and live server status (FR-12, FR-14). Linked from the footer, not the main menu:
 * it is for the curious, not part of the first impression. Every text is UI copy (`stats.*`).
 */
import ServerStatus from '@/components/stats/ServerStatus.astro';
import SiteStats from '@/components/stats/SiteStats.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { getProfile } from '@/lib/content/queries';
import { localeStaticPaths, type Locale, UI } from '@/lib/i18n';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale];
const profile = await getProfile();
---

<PageLayout
  locale={locale}
  title={`${t['stats.title']} · ${profile.name}`}
  description={t['stats.intro']}
  profile={profile}
>
  <div class="mx-auto grid max-w-[880px] gap-10 px-[clamp(16px,4vw,40px)] py-16">
    <header class="grid max-w-[65ch] gap-4">
      <h1 id="stats-title" class="text-h2">
        {t['stats.title']}
      </h1>
      <p class="text-lg text-ink-muted">{t['stats.intro']}</p>
      <ServerStatus locale={locale} />
    </header>

    <SiteStats locale={locale} />
  </div>
</PageLayout>
