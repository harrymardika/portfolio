---
/**
 * CVs by role (T10.2, D10): every CV variant PDF in both languages, linked from the footer at the
 * owner's request. noindex so search results keep the main positioning; downloads are counted like the
 * hero's CV button. The PDFs are made by scripts/generate-pdf.ts.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import { localize } from '@/lib/content';
import { getCvVariants, getProfile } from '@/lib/content/queries';
import { downloadPath, DOWNLOADS_DIR, variantDownloads } from '@/lib/downloads';
import { localeStaticPaths, type Locale, UI } from '@/lib/i18n';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale];
const [profile, variants] = await Promise.all([getProfile(), getCvVariants()]);
const rows = variants.map((variant) => ({
  variant,
  files: variantDownloads(profile.name, [variant]).map((download) => ({
    label: download.locale.toUpperCase(),
    lang: download.locale,
    href: `/${DOWNLOADS_DIR}/${download.file}`,
  })),
}));
---

<PageLayout
  locale={locale}
  title={`${t['cvVariants.title']} · ${profile.name}`}
  description={t['cvVariants.intro']}
  profile={profile}
  noindex
>
  <div class="mx-auto grid max-w-[860px] gap-6 px-[clamp(16px,4vw,40px)] py-16">
    <h1 class="text-h2">{t['cvVariants.title']}</h1>
    <p class="text-ink-muted">{t['cvVariants.intro']}</p>
    <p>
      <a
        href={downloadPath(profile.name, 'cv', locale)}
        download
        data-download="cv"
        class="inline-flex min-h-11 items-center font-semibold text-forest-ink underline underline-offset-4"
      >
        {t['cvVariants.main']}
      </a>
    </p>
    {rows.length === 0 ? (
      <p>{t['cvVariants.empty']}</p>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-line">
              <th scope="col" class="py-2 pr-4">
                {t['cvVariants.variant']}
              </th>
              <th scope="col" class="py-2 pr-4">
                {t['cvVariants.role']}
              </th>
              <th scope="col" class="py-2">
                {t['cvVariants.files']}
              </th>
            </tr>
          </thead>
          <tbody>
            {rows.map(({ variant, files }) => (
              <tr class="border-b border-line">
                <th scope="row" class="py-3 pr-4 font-semibold">
                  {localize(variant.name, locale)}
                </th>
                <td class="py-3 pr-4 text-ink-muted">{localize(variant.role, locale)}</td>
                <td class="py-3">
                  <span class="flex gap-3">
                    {files.map((file) => (
                      <a
                        href={file.href}
                        hreflang={file.lang}
                        download
                        data-download="cv"
                        class="inline-flex min-h-11 items-center font-semibold text-forest-ink underline underline-offset-4"
                        aria-label={`${localize(variant.name, locale)} ${t['cvVariants.files']} ${file.label}`}
                      >
                        {file.label}
                      </a>
                    ))}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</PageLayout>
