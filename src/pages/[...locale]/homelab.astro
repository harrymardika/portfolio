---
/**
 * How this site is built and served (SRS FR-14). Live uptime status arrives in T6.5;
 * the hardware section appears once content/homelab.yaml lists real specs.
 */
import SiteStats from '@/components/stats/SiteStats.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { localize } from '@/lib/content';
import { getHomelab, getProfile } from '@/lib/content/queries';
import { localeStaticPaths, type Locale, UI } from '@/lib/i18n';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale];
const [profile, homelab] = await Promise.all([getProfile(), getHomelab()]);
const intro = localize(homelab.intro, locale);
---

<PageLayout
  locale={locale}
  title={`${t['homelab.title']} · ${profile.name}`}
  description={intro}
  profile={profile}
>
  <div class="mx-auto grid max-w-[880px] gap-14 px-[clamp(16px,4vw,40px)] py-16">
    <header class="grid max-w-[65ch] gap-4">
      <h1 class="text-h2">{t['homelab.title']}</h1>
      <p class="text-lg text-ink-muted">{intro}</p>
    </header>

    <section aria-labelledby="pipeline-title" class="grid gap-6">
      <h2 id="pipeline-title" class="text-h3">
        {t['homelab.pipeline']}
      </h2>
      <ol class="grid gap-4 md:grid-cols-2">
        {homelab.pipeline.map((step, index) => (
          <li class="grid content-start gap-2 rounded-xl border border-line bg-surface p-5">
            <span class="inline-flex size-8 items-center justify-center rounded-full bg-forest font-mono text-sm text-on-forest">
              {index + 1}
            </span>
            <h3 class="font-sans text-base font-semibold text-ink">{localize(step.title, locale)}</h3>
            <p class="text-sm text-ink-muted">{localize(step.body, locale)}</p>
          </li>
        ))}
      </ol>
    </section>

    <SiteStats locale={locale} />

    <section aria-labelledby="stack-title" class="grid gap-4">
      <h2 id="stack-title" class="text-h3">
        {t['homelab.stack']}
      </h2>
      <ul class="flex flex-wrap gap-2">
        {homelab.stack.map((item) => (
          <li class="rounded-full border border-line bg-surface px-3 py-1 text-sm">{item}</li>
        ))}
      </ul>
    </section>

    {homelab.hardware.length > 0 && (
      <section aria-labelledby="hardware-title" class="grid gap-4">
        <h2 id="hardware-title" class="text-h3">
          {t['homelab.hardware']}
        </h2>
        <dl class="grid gap-x-8 gap-y-3 sm:grid-cols-2">
          {homelab.hardware.map((spec) => (
            <div class="grid border-b border-line pb-2">
              <dt class="font-mono text-eyebrow text-amber-deep uppercase">{localize(spec.label, locale)}</dt>
              <dd>{spec.value}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}
  </div>
</PageLayout>
