---
import ProjectGrid from '@/components/projects/ProjectGrid.astro';
import TagFilter from '@/components/projects/TagFilter.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { collectTags, itemTags, localize } from '@/lib/content';
import { getProfile, getProjectItems } from '@/lib/content/queries';
import { localeStaticPaths, type Locale, UI } from '@/lib/i18n';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale];
const [profile, items] = await Promise.all([getProfile(), getProjectItems()]);
// Only tags shared by 2+ projects are useful filters; with fewer than two such tags, hide the filter.
const tags = collectTags(
  items.map((item) => ({ tags: itemTags(item) })),
  2,
);
const intro = localize(profile.projects.intro, locale);
---

<PageLayout
  locale={locale}
  title={`${t['projects.title']} · ${profile.name}`}
  description={intro}
  profile={profile}
>
  <section class="mx-auto grid max-w-[1120px] gap-8 px-[clamp(16px,4vw,40px)] py-16">
    <header class="grid max-w-[65ch] gap-3">
      <h1 class="text-h2">{t['projects.title']}</h1>
      <p class="text-ink-muted">{intro}</p>
    </header>
    <div class="grid gap-6">
      {tags.length >= 2 && <TagFilter locale={locale} tags={tags} />}
      <ProjectGrid locale={locale} items={items} headingLevel={2} />
    </div>
  </section>
</PageLayout>
