---
import ProjectGrid from '@/components/projects/ProjectGrid.astro';
import ProjectFilter from '@/components/projects/ProjectFilter.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { itemTags, localize, usefulCategories } from '@/lib/content';
import { getProfile, getProjectItems } from '@/lib/content/queries';
import { localeStaticPaths, type Locale, UI } from '@/lib/i18n';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale];
const [profile, items] = await Promise.all([getProfile(), getProjectItems()]);
// Field filters from profile.yaml; a category holding fewer than 2 projects is left out.
const { categories } = profile.projects;
const filters = usefulCategories(items.map(itemTags), categories);
const intro = localize(profile.projects.intro, locale);
---

<PageLayout
  locale={locale}
  title={`${t['projects.title']} · ${profile.name}`}
  description={intro}
  profile={profile}
>
  <section class="mx-auto grid max-w-[1120px] gap-8 px-[clamp(16px,4vw,40px)] py-16">
    <header class="grid max-w-[65ch] gap-3">
      <h1 class="text-h2">{t['projects.title']}</h1>
      <p class="text-ink-muted">{intro}</p>
    </header>
    <div class="grid gap-6">
      {items.length > 1 && <ProjectFilter locale={locale} categories={filters} total={items.length} />}
      <ProjectGrid locale={locale} items={items} headingLevel={2} categories={categories} />
    </div>
  </section>
</PageLayout>
