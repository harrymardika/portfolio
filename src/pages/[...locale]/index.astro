---
/**
 * Home page in every locale. Sections are added by later tasks (journey T2.3, contact T2.6).
 */
import Hero from '@/components/hero/Hero.astro';
import Journey from '@/components/journey/Journey.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { localize } from '@/lib/content';
import { getJourney, getProfile } from '@/lib/content/queries';
import { localeStaticPaths, type Locale } from '@/lib/i18n';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const [profile, journey] = await Promise.all([getProfile(), getJourney()]);
---

<PageLayout
  locale={locale}
  title={`${profile.name} · ${localize(profile.role, locale)}`}
  description={localize(profile.tagline, locale)}
  profile={profile}
>
  <Hero locale={locale} profile={profile} />
  <Journey locale={locale} copy={profile.journey} entries={journey} />
</PageLayout>
