---
/**
 * Home page in every locale. Sections are added by later tasks (journey T2.3, contact T2.6).
 */
import Contact from '@/components/contact/Contact.astro';
import Hero from '@/components/hero/Hero.astro';
import Journey from '@/components/journey/Journey.astro';
import SelectedProjects from '@/components/projects/SelectedProjects.astro';
import Messages from '@/components/messages/Messages.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { localize } from '@/lib/content';
import { getJourney, getProfile, getProjectItems, getMessages } from '@/lib/content/queries';
import { localeStaticPaths, localizePath, type Locale } from '@/lib/i18n';
import { websiteJsonLd } from '@/lib/seo';
import { getPersonJsonLd, requireSite } from '@/lib/seo/person';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const [profile, journey, items, messages] = await Promise.all([
  getProfile(),
  getJourney(),
  getProjectItems(),
  getMessages(),
]);
// Home shows featured case studies only; GitHub-only repos appear on the Projects page.
const featured = items.filter((item) => item.kind === 'local' && item.project.featured).slice(0, 3);
const site = requireSite(Astro.site);
const jsonLd = [
  await getPersonJsonLd(locale, site),
  websiteJsonLd({ name: profile.name, site, locale, url: new URL(localizePath('/', locale), site).href }),
];
---

<PageLayout
  locale={locale}
  title={`${profile.name} · ${localize(profile.role, locale)}`}
  description={localize(profile.tagline, locale)}
  profile={profile}
  jsonLd={jsonLd}
>
  <Hero locale={locale} profile={profile} />
  <Journey locale={locale} copy={profile.journey} entries={journey} />
  <SelectedProjects locale={locale} copy={profile.projects} items={featured} />
  <Messages locale={locale} items={messages} ownerName={profile.name} />
  <Contact locale={locale} profile={profile} />
</PageLayout>
