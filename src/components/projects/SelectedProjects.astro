---
/**
 * Home page section with featured projects as index rows (D20) and a link to the full list. Above the
 * rows, the data of the room's sorting line (T13.6): its cards (featured first, then other case
 * studies that belong to a field) and bins (the fields) come from content/; the line itself stands on
 * the room's floor (ADR 0020), so the band takes no space.
 */
import ProjectIndex from './ProjectIndex.astro';
import { itemYear, localize, sortingLine, type Profile, type ProjectItem } from '@/lib/content';
import { localizePath, type Locale, UI } from '@/lib/i18n';

interface Props {
  locale: Locale;
  copy: Profile['projects'];
  items: ProjectItem[];
  /** Every project item, for the sorting line. */
  all?: ProjectItem[];
}

/** Cards on the sorting line: enough to keep it busy, few enough to stay light. */
const LINE_CARDS = 8;

const { locale, copy, items, all = [] } = Astro.props;
const t = UI[locale];
const caseStudies = all.filter((item) => item.kind === 'local');
const ordered = [
  ...caseStudies.filter((item) => item.project.featured),
  ...caseStudies.filter((item) => !item.project.featured),
];
const line = sortingLine(
  ordered.map((item) => ({ item, tags: item.project.tags })),
  copy.categories,
  LINE_CARDS,
);
const cards = line.cards.map(({ project: { item }, bin }) => ({
  title: item.project.title,
  href: localizePath(`/projects/${item.slug}/`, locale),
  year: String(itemYear(item)),
  bin,
}));
const bins = line.bins.map((bin) => ({ id: bin.id, label: localize(bin.label, locale) }));
---

{items.length > 0 && (
  <section
    id="projects"
    aria-labelledby="projects-title"
    class="scroll-mt-20 border-t border-line"
    data-room-section="projects"
  >
    <div class="projects-room mx-auto grid max-w-[1120px] gap-8 px-[clamp(16px,4vw,40px)] py-16 lg:py-24">
      <div class="flex flex-wrap items-end justify-between gap-4" data-room-copy>
        <div class="grid max-w-[60ch] gap-3">
          <h2 id="projects-title" class="text-h2">
            {t['projects.selected']}
          </h2>
          <p class="text-ink-muted">{localize(copy.intro, locale)}</p>
        </div>
        <a
          href={localizePath('/projects/', locale)}
          class="font-semibold text-forest-ink underline decoration-line underline-offset-4 hover:decoration-current"
        >
          {t['projects.viewAll']}
        </a>
      </div>
      {cards.length > 0 && (
        <div
          class="sorting-band"
          data-room-band
          data-room-slot="sorting"
          data-cards={JSON.stringify(cards)}
          data-bins={JSON.stringify(bins)}
          aria-hidden="true"
        ></div>
      )}
      <ProjectIndex locale={locale} items={items} />
    </div>
  </section>
)}

<style>
  /*
   * The sorting line stands on the room's floor (ADR 0020), drawn by the camera, not in the page flow:
   * the band only carries its data (cards, bins, and what is detected).
   */
  .sorting-band {
    height: 0;
  }

  /*
   * The projects room (ADR 0020, after the approved preview): the heading and the selected projects
   * sit on one panel, so the journey thread and the line behind them never cut through the text. On
   * wide screens the panel stays at the top, three projects to a row, while the camera shows the
   * sorting line on the floor below it (the rows never cover the line or catch a click meant for its
   * cards); on phones the line fills the top of the screen and the panel comes below.
   */
  :root[data-room-3d] .projects-room {
    border-radius: 0.875rem;
    background-color: color-mix(in srgb, var(--surface) 88%, transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  /* One panel is enough: the heading's own phone panel steps aside. */
  :root[data-room-3d] .projects-room [data-room-copy] {
    padding: 0;
    background: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  @media (width < 64rem) {
    :root[data-room-3d] .projects-room {
      width: auto;
      margin-inline: clamp(16px, 4vw, 40px);
      gap: 1.25rem;
      padding: 1.25rem;
    }
  }

  @media (width >= 64rem) {
    :root[data-room-3d] [data-room-section='projects'] {
      min-height: 150svh;
      justify-content: flex-start;
    }

    :root[data-room-3d] .projects-room {
      position: sticky;
      top: 9svh;
      gap: 1.25rem;
      padding-block: 1.5rem;
    }

    :root[data-room-3d] .projects-room :global([data-project-grid]) {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 1.75rem;
      border-bottom: 0;
    }

    :root[data-room-3d] .projects-room :global([data-project-grid] > li) {
      border-bottom: 1px solid var(--line);
    }

    :root[data-room-3d] .projects-room :global(.project-row) {
      grid-template-columns: minmax(0, 1fr);
      padding-block: 0.75rem;
    }

    :root[data-room-3d] .projects-room :global(.project-row .role) {
      display: none;
    }

    :root[data-room-3d] .projects-room :global(.project-row .main > p) {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    :root[data-room-3d] .projects-room :global(.project-row .metric) {
      text-align: left;
    }
  }
</style>
