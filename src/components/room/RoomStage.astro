---
/**
 * The fixed stage of the "one room" (ADR 0019): one canvas behind the whole page. Hidden from
 * assistive technology and never in the way of clicks; the page script mounts the room on it
 * (src/scenes/room/) only when the device should run 3D. Without it, every part's HTML stays.
 * Keep it out of any ancestor with transform, filter, contain, or isolation, or `fixed` breaks.
 * It is 100lvh tall (not the dynamic viewport), so a phone's collapsing toolbar never resizes it.
 */
---

<div class="room-stage" data-room-stage aria-hidden="true">
  <canvas></canvas>
</div>

<style>
  .room-stage {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    height: 100lvh;
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .room-stage[data-scene-ready] {
    opacity: 1;
  }

  .room-stage canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media print {
    .room-stage {
      display: none;
    }
  }
</style>
