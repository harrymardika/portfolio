---
/**
 * The home page's room (ADR 0019): the fixed stage plus the script that mounts it with the home
 * parts. Decides before downloading three.js, so devices that should not run 3D never fetch it, and
 * waits for the load event so the 3D never competes with the LCP image. Marks the root with
 * `data-room-3d` while the room runs, so bands that only hold 3D (global.css) take space.
 */
import RoomStage from './RoomStage.astro';
---

<RoomStage />

<script>
  import { decide3D, detectCapabilities } from '@/scenes/core/capabilities';

  import type { RoomPart } from '@/scenes/room';

  async function start(): Promise<void> {
    const stage = document.querySelector<HTMLElement>('[data-room-stage]');
    if (!stage) return;
    if (decide3D(detectCapabilities()).mode === 'off') {
      stage.dataset['scene'] = 'off';
      return;
    }
    // Reserve the 3D-only bands now: they sit far below the first screen, and scroll anchoring keeps
    // the view steady if the page was already scrolled.
    document.documentElement.setAttribute('data-room-3d', '');
    const [
      { mountRoom },
      { createHeroPart },
      { createJourneyPart },
      { createSortingPart },
      { createNotesPart },
      { createLaptopPart },
    ] = await Promise.all([
      import('@/scenes/room'),
      import('@/scenes/room/parts/hero'),
      import('@/scenes/room/parts/journey'),
      import('@/scenes/room/parts/sorting'),
      import('@/scenes/room/parts/notes'),
      import('@/scenes/room/parts/laptop'),
    ]);
    const find = (selector: string) => document.querySelector<HTMLElement>(selector);
    const parts = [
      createHeroPart(find('[data-room-slot="hero"]')),
      createJourneyPart(find('[data-journey-stage]'), {
        from: find('[data-room-slot="hero"] [data-print="sheet"]'),
        to: find('#projects'),
        avoid: find('[data-journey-intro]'),
      }),
      createSortingPart(find('[data-room-slot="sorting"]')),
      createNotesPart(find('[data-room-slot="notes"]')),
      createLaptopPart(find('[data-room-slot="laptop"]')),
    ].filter((part): part is RoomPart => part !== null);
    if (!mountRoom(stage, parts)) document.documentElement.removeAttribute('data-room-3d');
  }

  // A chunk that fails to load (flaky network, or a deploy replacing it while the tab is open) must
  // not leave the 3D-only bands reserved and empty.
  function run(): void {
    start().catch((error: unknown) => {
      document.documentElement.removeAttribute('data-room-3d');
      console.warn('3D: the room failed to load', error);
    });
  }

  if (document.readyState === 'complete') run();
  else window.addEventListener('load', run, { once: true });
</script>
