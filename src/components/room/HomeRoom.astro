---
/**
 * The home page's room (ADR 0019): the fixed stage plus the script that mounts it with the home
 * parts. Decides before downloading three.js, so devices that should not run 3D never fetch it, and
 * waits for the load event so the 3D never competes with the LCP image.
 */
import RoomStage from './RoomStage.astro';
---

<RoomStage />

<script>
  import { decide3D, detectCapabilities } from '@/scenes/core/capabilities';

  import type { RoomPart } from '@/scenes/room';

  async function start(): Promise<void> {
    const stage = document.querySelector<HTMLElement>('[data-room-stage]');
    if (!stage) return;
    if (decide3D(detectCapabilities()).mode === 'off') {
      stage.dataset['scene'] = 'off';
      return;
    }
    const [{ mountRoom }, { createHeroPart }, { createJourneyPart }] = await Promise.all([
      import('@/scenes/room'),
      import('@/scenes/room/parts/hero'),
      import('@/scenes/room/parts/journey'),
    ]);
    const find = (selector: string) => document.querySelector<HTMLElement>(selector);
    const parts = [
      createHeroPart(find('[data-room-slot="hero"]')),
      createJourneyPart(find('[data-journey-stage]'), {
        from: find('[data-room-slot="hero"] [data-print="sheet"]'),
        to: find('#projects'),
        avoid: find('[data-journey-intro]'),
      }),
    ].filter((part): part is RoomPart => part !== null);
    mountRoom(stage, parts);
  }

  if (document.readyState === 'complete') void start();
  else window.addEventListener('load', () => void start(), { once: true });
</script>
