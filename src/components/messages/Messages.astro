---
/**
 * "Kind words" / "Kesan & pesan" on the home page (T9.4, D15): messages people left for the owner,
 * from content/messages.yaml, and a link to the form for leaving one (T12.2). While the list is empty
 * only the invitation shows. A message without an Indonesian version is shown in English and marked
 * lang="en".
 */
import { isFallback, localize, type LocalizedText, type Message } from '@/lib/content';
import { localizePath, type Locale, UI } from '@/lib/i18n';

interface Props {
  locale: Locale;
  items: Message[];
  /** The owner's name, for the invitation to leave a message. */
  ownerName: string;
}

const { locale, items, ownerName } = Astro.props;
const t = UI[locale];
/** Role (optional) and relationship, each marked lang="en" on its own when not translated. */
const details = (item: Message): LocalizedText[] =>
  item.role ? [item.role, item.relationship] : [item.relationship];
---

<section id="messages" aria-labelledby="messages-title" class="scroll-mt-20 border-t border-line">
  <div class="mx-auto grid max-w-[1120px] gap-8 px-[clamp(16px,4vw,40px)] py-16 lg:py-24">
    <h2 id="messages-title" class="text-h2">
      {t['messages.title']}
    </h2>
    {items.length > 0 && (
      <ul class="notes grid gap-5 md:grid-cols-2" data-room-slot="notes">
        {items.map((item) => (
          <li>
            <figure class="grid h-full content-between gap-5 rounded-xl border border-line bg-surface p-6">
              <blockquote
                class="text-lg leading-relaxed text-ink"
                lang={isFallback(item.message, locale) ? 'en' : undefined}
              >
                <p>“{localize(item.message, locale)}”</p>
              </blockquote>
              <figcaption class="grid gap-0.5 text-sm">
                {item.link ? (
                  <a
                    href={item.link}
                    rel="nofollow ugc"
                    aria-label={`${t['messages.profile']} ${item.name}`}
                    class="w-max font-semibold text-forest-ink underline underline-offset-4"
                  >
                    {item.name} ↗
                  </a>
                ) : (
                  <span class="font-semibold text-ink">{item.name}</span>
                )}
                {details(item).map((text) => (
                  <span class="text-ink-muted" lang={isFallback(text, locale) ? 'en' : undefined}>
                    {localize(text, locale)}
                  </span>
                ))}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    )}
    <p class="flex flex-wrap items-center gap-x-4 gap-y-2 text-ink-muted">
      {t['messages.invite'].replaceAll('{name}', ownerName)}
      <a
        href={localizePath('/messages/', locale)}
        class="inline-flex min-h-11 items-center rounded-full border border-line px-5 font-semibold text-forest-ink transition-colors hover:bg-surface"
      >
        {t['messages.leave']}
      </a>
    </p>
  </div>
</section>

<style>
  /* With the room drawn, each message sits on its own 3D paper note (T13.6): the card steps aside. */
  .notes[data-room-ready] figure {
    border-color: transparent;
    background-color: transparent;
  }
</style>
