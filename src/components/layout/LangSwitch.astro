---
/**
 * Language switch: links to the same page in every locale.
 * Plain links (no JS) so it works everywhere and search engines can follow it.
 */
import { alternates, LOCALES, type Locale, UI } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const paths = alternates(Astro.url.pathname);
---

<nav
  aria-label={UI[locale]['lang.switchLabel']}
  class="flex rounded-full border border-line p-0.5 font-mono text-xs"
>
  {LOCALES.map((target) => (
    <a
      href={paths[target]}
      hreflang={target}
      lang={target}
      aria-current={target === locale ? 'true' : undefined}
      title={UI[target]['lang.readIn']}
      class="rounded-full px-2.5 py-1 text-ink-muted transition-colors hover:text-ink aria-[current=true]:bg-forest aria-[current=true]:text-on-forest dark:aria-[current=true]:bg-amber dark:aria-[current=true]:text-forest"
    >
      <span aria-hidden="true">{UI[target]['lang.short']}</span>
      <span class="sr-only">{UI[target]['lang.name']}</span>
    </a>
  ))}
</nav>
