---
/**
 * Home hero (docs/03-design-system.md §5): the owner's name as H1 (D19), role and city, headline and
 * tagline, the two PDF downloads, the highlights with their context, and the photo card.
 * Content comes from profile.yaml; the 3D card loads after the page is interactive.
 */
import PhotoCard from './PhotoCard.astro';
import DownloadIcon from '@/components/ui/DownloadIcon.astro';
import { localize, localizeNumber, stripEmphasis, type Profile } from '@/lib/content';
import { contentImage } from '@/lib/content/media';
import { downloadPath } from '@/lib/downloads';
import { fill, type Locale, UI } from '@/lib/i18n';

interface Props {
  locale: Locale;
  profile: Profile;
}

const { locale, profile } = Astro.props;
const t = UI[locale];
const role = localize(profile.role, locale);
const headline = stripEmphasis(localize(profile.headline, locale));
const city = profile.location.split(',')[0] ?? profile.location;
const roleLine = fill(t['hero.roleIn'], { role, city });
---

<section aria-labelledby="hero-title">
  <div class="mx-auto grid max-w-[1120px] items-center gap-10 px-[clamp(16px,4vw,40px)] py-14 lg:grid-cols-[1.05fr_1fr] lg:py-20">
    <div class="grid min-w-0 gap-6">
      <p class="text-ink-muted">{roleLine}</p>
      <h1 id="hero-title" class="text-name">
        {profile.name}
      </h1>
      <p class="max-w-[30ch] font-display text-h3 text-forest-ink">{headline}</p>
      <p class="max-w-[42ch] text-base text-ink sm:text-lg">{localize(profile.tagline, locale)}</p>
      <div class="flex flex-wrap gap-3">
        <a
          href={downloadPath(profile.name, 'cv', locale)}
          download
          data-download="cv"
          class="inline-flex min-h-11 items-center gap-2 rounded-full bg-amber px-5 font-semibold text-forest transition hover:brightness-105"
        >
          <DownloadIcon />
          {t['download.cv']}
        </a>
        <a
          href={downloadPath(profile.name, 'portfolio', locale)}
          download
          data-download="portfolio"
          class="inline-flex min-h-11 items-center gap-2 rounded-full border border-ink/40 px-5 font-semibold text-ink transition hover:bg-surface"
        >
          <DownloadIcon />
          {t['download.portfolio']}
        </a>
      </div>
      <dl class="grid max-w-[46ch] border-t border-line" aria-label={t['hero.statsLabel']}>
        {profile.stats.map((stat) => (
          <div class="grid grid-cols-[5rem_minmax(0,1fr)] items-baseline gap-3 border-b border-line py-2 text-sm">
            <dt class="text-base font-semibold text-amber-deep tabular-nums">
              {localizeNumber(stat.value, locale)}
            </dt>
            <dd class="text-ink-muted">{localize(stat.label, locale)}</dd>
          </div>
        ))}
      </dl>
    </div>
    <PhotoCard
      photo={contentImage(profile.photo)}
      alt={`${t['hero.photoAlt']} ${profile.name}`}
      name={profile.name}
      role={role}
      location={city}
      detectionLabel={t['hero.detectionLabel']}
    />
  </div>
</section>

<script>
  import { decide3D, detectCapabilities } from '@/scenes/core/capabilities';

  // Decide before downloading three.js so low-power and reduced-data visitors never fetch it.
  async function start(): Promise<void> {
    const decision = decide3D(detectCapabilities());
    const stages = document.querySelectorAll<HTMLElement>('[data-photo-card]');
    if (decision.mode === 'off' || stages.length === 0) {
      stages.forEach((stage) => (stage.dataset['scene'] = 'off'));
      return;
    }
    const [{ mountScene }, { createPhotoCard }] = await Promise.all([
      import('@/scenes/core/mount'),
      import('@/scenes/photo-card'),
    ]);
    for (const stage of stages) {
      const canvas = stage.querySelector('canvas');
      const { photoUrl, name, role, location, detectionLabel } = stage.dataset;
      if (!canvas || !photoUrl || !name || !role || !location || !detectionLabel) continue;
      mountScene({
        stage,
        canvas,
        decision,
        create: (setup) => createPhotoCard(setup, { photoUrl, name, role, location, detectionLabel }),
      });
    }
  }

  // Wait until the page has loaded so the 3D never competes with the LCP image.
  if (document.readyState === 'complete') void start();
  else window.addEventListener('load', () => void start(), { once: true });
</script>
