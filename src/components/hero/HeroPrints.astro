---
/**
 * The hero's two prints (T13.4, ADR 0019): the owner's photo in front of a sheet with his name in
 * Javanese script, each with its detection boxes. This HTML is the LCP image, the no-JS/no-WebGL
 * version, and the slot the room's 3D prints are anchored to; once the 3D prints are ready
 * (data-room-ready) they take its place. Geometry comes from hero-config.ts, shared with the 3D.
 */
import { Image, getImage } from 'astro:assets';

import sheetData from '../../../content/media/aksara-sheet.json';
import { contentImage } from '@/lib/content/media';
import { fill, type Locale, UI } from '@/lib/i18n';
import { FACE_BOX, photoPrintPadding, PRINTS } from '@/scenes/room/parts/hero-config';

interface Props {
  locale: Locale;
  name: string;
  photo: string;
}

const { locale, name, photo } = Astro.props;
const t = UI[locale];
const photoImage = contentImage(photo);
const sheetImage = contentImage('media/aksara-sheet.png');
// Textures for the 3D twins (the HTML uses responsive versions of the same images).
const photoTexture = await getImage({ src: photoImage, width: 640, format: 'webp' });
const sheetTexture = await getImage({ src: sheetImage, width: 1200, format: 'webp' });
const pct = (value: number) => `${(value * 100).toFixed(3)}%`;
const place = (print: { left: number; top: number; width: number; rotate: number }) =>
  `left:${pct(print.left)};top:${pct(print.top)};width:${pct(print.width)};--turn:${print.rotate}deg`;
const box = (b: { x: number; y: number; w: number; h: number }) =>
  `left:${pct(b.x)};top:${pct(b.y)};width:${pct(b.w)};height:${pct(b.h)}`;
const face = box({ x: FACE_BOX.x, y: FACE_BOX.y, w: FACE_BOX.width, h: FACE_BOX.height });
const padding = photoPrintPadding();
---

<figure
  class="hero-prints mx-auto grid w-full max-w-[600px] gap-3"
  data-room-slot="hero"
  data-photo-url={photoTexture.src}
  data-sheet-url={sheetTexture.src}
  data-boxes={JSON.stringify(sheetData.boxes)}
  data-person={t['hero.detectedPerson']}
  data-name={name}
>
  <div class="stage relative w-full" style={`aspect-ratio:${PRINTS.aspect}`}>
    <div class="print sheet absolute" data-print="sheet" style={place(PRINTS.sheet)}>
      <Image
        src={sheetImage}
        alt={fill(t['hero.sheetAlt'], { name })}
        widths={[400, 700, 1000]}
        sizes="(min-width: 1024px) 360px, 60vw"
        loading="eager"
        fetchpriority="high"
        class="block h-auto w-full"
      />
      {sheetData.boxes.map((b) => (
        <span class="box absolute" style={box(b)} aria-hidden="true">
          <span class="tag font-mono">{b.cls}</span>
          <span class="latin">{b.latin}</span>
        </span>
      ))}
    </div>
    <div
      class="print photo absolute"
      data-print="photo"
      style={`${place(PRINTS.photo)};padding:${pct(padding.side)} ${pct(padding.side)} ${pct(padding.bottom)}`}
    >
      <div class="relative">
        <Image
          src={photoImage}
          alt={`${t['hero.photoAlt']} ${name}`}
          widths={[320, 480, 640]}
          sizes="(min-width: 1024px) 270px, 45vw"
          loading="eager"
          fetchpriority="high"
          class="block aspect-square w-full object-cover"
        />
        <span class="box absolute" style={face} aria-hidden="true">
          <span class="tag">{name}</span>
        </span>
      </div>
    </div>
  </div>
  <figcaption class="flex flex-wrap items-center justify-end gap-x-4 gap-y-2 text-right text-sm text-ink-muted">
    <span>{t['hero.caption']}</span>
    <button
      type="button"
      data-replay
      hidden
      class="min-h-11 rounded-full border border-ink/40 px-4 font-semibold text-ink hover:bg-surface"
    >
      {t['hero.replay']}
    </button>
  </figcaption>
</figure>

<style>
  .print {
    transform: rotate(var(--turn));
    transition: opacity 0.5s ease;
  }

  .sheet {
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.45);
  }

  .photo {
    z-index: 1;
    /* The photo print's own paper is always white, like a real print. */
    background: var(--on-forest);
    box-shadow: 0 24px 48px -20px rgb(0 0 0 / 0.5);
  }

  /* Corner brackets drawn with gradients, matching the 3D detection boxes. */
  .box {
    --arm: 12px;
    --c: var(--amber);
    background:
      linear-gradient(var(--c), var(--c)) 0 0 / var(--arm) 2px no-repeat,
      linear-gradient(var(--c), var(--c)) 0 0 / 2px var(--arm) no-repeat,
      linear-gradient(var(--c), var(--c)) 100% 0 / var(--arm) 2px no-repeat,
      linear-gradient(var(--c), var(--c)) 100% 0 / 2px var(--arm) no-repeat,
      linear-gradient(var(--c), var(--c)) 0 100% / var(--arm) 2px no-repeat,
      linear-gradient(var(--c), var(--c)) 0 100% / 2px var(--arm) no-repeat,
      linear-gradient(var(--c), var(--c)) 100% 100% / var(--arm) 2px no-repeat,
      linear-gradient(var(--c), var(--c)) 100% 100% / 2px var(--arm) no-repeat;
  }

  .tag,
  .latin {
    position: absolute;
    left: 0;
    padding: 1px 5px;
    background: var(--amber);
    color: var(--forest);
    font-size: clamp(9px, 1.4vw, 12px);
    line-height: 1.3;
    white-space: nowrap;
  }

  .tag {
    bottom: 100%;
  }

  .latin {
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    font-weight: 600;
  }

  /* The 3D twins took over: keep the layout, hide the flat versions. */
  .hero-prints[data-room-ready] .print {
    opacity: 0;
  }
</style>
