---
/**
 * Static photo card: the LCP image, the no-JS/no-WebGL fallback, and the 3D scene's stage.
 * When the 3D card is ready (data-scene-ready), the canvas cross-fades over this card.
 */
import { Image, getImage } from 'astro:assets';

import { FACE_BOX } from '@/scenes/photo-card/config';

import type { ImageMetadata } from 'astro';

interface Props {
  photo: ImageMetadata;
  alt: string;
  name: string;
  role: string;
  location: string;
  detectionLabel: string;
}

const { photo, alt, name, role, location, detectionLabel } = Astro.props;
// Same photo, sized for the 3D texture (drawn at 584 px inside a 640 px card).
const texture = await getImage({ src: photo, width: 640, format: 'webp' });
const faceBox = `left:${FACE_BOX.x * 100}%;top:${FACE_BOX.y * 100}%;width:${FACE_BOX.width * 100}%;height:${FACE_BOX.height * 100}%`;
---

<div
  class="photo-stage relative mx-auto aspect-[66/54] w-full max-w-[520px]"
  data-photo-card
  data-photo-url={texture.src}
  data-name={name}
  data-role={role}
  data-location={location}
  data-detection-label={detectionLabel}
>
  <figure class="static-card absolute top-1/2 left-1/2 w-[48%] -translate-1/2 rounded-[1.25rem] bg-on-forest p-[4.4%] shadow-2xl">
    <div class="relative">
      <Image
        src={photo}
        alt={alt}
        widths={[320, 480, 640]}
        sizes="(min-width: 1024px) 250px, 48vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-square w-full rounded-[0.9rem] object-cover"
      />
      <div class="detection pointer-events-none absolute" style={faceBox} aria-hidden="true">
        <span class="absolute -top-6 left-0 bg-amber px-1.5 py-0.5 font-mono text-[10px] whitespace-nowrap text-forest">
          {detectionLabel}
        </span>
      </div>
    </div>
    <figcaption class="grid gap-0.5 px-1 pt-3">
      <span class="font-display text-lg leading-tight text-forest">{name}</span>
      <span class="text-xs text-forest/75">{role}</span>
      <span class="mt-1.5 w-max rounded-full bg-amber px-2.5 py-0.5 text-[11px] font-bold text-forest">
        {location}
      </span>
    </figcaption>
  </figure>
  <canvas class="absolute inset-0 size-full opacity-0" aria-hidden="true"></canvas>
</div>

<style>
  /* Corner brackets drawn with gradients, matching the 3D detection frame. */
  .detection {
    --arm: 14px;
    --c: var(--amber);
    background:
      linear-gradient(var(--c), var(--c)) 0 0 / var(--arm) 2px no-repeat,
      linear-gradient(var(--c), var(--c)) 0 0 / 2px var(--arm) no-repeat,
      linear-gradient(var(--c), var(--c)) 100% 0 / var(--arm) 2px no-repeat,
      linear-gradient(var(--c), var(--c)) 100% 0 / 2px var(--arm) no-repeat,
      linear-gradient(var(--c), var(--c)) 0 100% / var(--arm) 2px no-repeat,
      linear-gradient(var(--c), var(--c)) 0 100% / 2px var(--arm) no-repeat,
      linear-gradient(var(--c), var(--c)) 100% 100% / var(--arm) 2px no-repeat,
      linear-gradient(var(--c), var(--c)) 100% 100% / 2px var(--arm) no-repeat;
  }

  .static-card,
  canvas {
    transition: opacity 400ms ease;
  }

  .photo-stage[data-scene-ready] .static-card {
    opacity: 0;
  }

  .photo-stage[data-scene-ready] canvas {
    opacity: 1;
  }
</style>
