---
/**
 * Contact section (FR-02): the e-mail address large, with a copy button (JavaScript only), then the
 * social profiles as plain links. No phone number. All channels come from profile.yaml socials.
 * With the room, the homelab laptop (T13.6, drawn by the camera beside the copy, ADR 0020) and its
 * caption under the links, which only shows when the 3D runs.
 */
import { localize, stripEmphasis, type Profile } from '@/lib/content';
import { fill, LOCALE_TAGS, type Locale, UI } from '@/lib/i18n';
import { SOCIAL_LABELS } from '@/lib/navigation';

interface Props {
  locale: Locale;
  profile: Pick<Profile, 'contact' | 'socials' | 'email' | 'name' | 'role' | 'location'>;
}

const { locale, profile } = Astro.props;
const t = UI[locale];
const title = stripEmphasis(localize(profile.contact.title, locale));
const email = profile.socials.find((social) => social.platform === 'email');
const profiles = profile.socials.filter((social) => social.platform !== 'email');
const host = Astro.site?.host ?? '';
// What the laptop's screen shows (T14.4): the home page in small, and the live status line.
const city = profile.location.split(',')[0] ?? profile.location;
const roleLine = fill(t['hero.roleIn'], { role: localize(profile.role, locale), city });
const stats = import.meta.env.PUBLIC_STATS_ENABLED === 'true';
---

<section id="contact" aria-labelledby="contact-title" class="scroll-mt-20" data-room-section="contact">
  <div class="contact-grid mx-auto grid max-w-[1120px] gap-10 px-[clamp(16px,4vw,40px)] py-16 lg:py-24">
    <div class="grid min-w-0 content-start gap-6" data-room-copy>
      <h2 id="contact-title" class="text-h2">
        {title}
      </h2>
      <p class="max-w-[48ch] text-ink-muted">{localize(profile.contact.intro, locale)}</p>
      {email && (
        <p class="flex flex-wrap items-center gap-x-5 gap-y-3">
          <a
            href={email.url}
            data-outbound="email"
            class="font-display text-[clamp(1.35rem,3.2vw,2.25rem)] leading-tight break-all text-forest-ink underline decoration-line decoration-1 underline-offset-[6px] hover:decoration-current"
          >
            {profile.email}
          </a>
          <button
            type="button"
            data-copy={profile.email}
            data-label-copied={t['contact.copied']}
            aria-label={t['contact.copyEmail']}
            class="hidden min-h-11 rounded-full border border-ink/40 bg-surface px-4 text-sm font-semibold text-ink hover:bg-sage [.js_&]:inline-flex [.js_&]:items-center"
          >
            <span data-copy-label>{t['contact.copy']}</span>
          </button>
        </p>
      )}
      <ul class="flex flex-wrap gap-x-6 gap-y-2 font-semibold">
        {profiles.map((social) => (
          <li>
            <a
              href={social.url}
              rel="me noopener"
              data-outbound={social.platform}
              class="inline-flex min-h-11 items-center text-ink underline decoration-line underline-offset-4 hover:decoration-current"
            >
              {SOCIAL_LABELS[social.platform]}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <figure
      class="laptop-band"
      data-room-band
      data-room-slot="laptop"
      data-host={host}
      data-name={profile.name}
      data-role={roleLine}
      data-cv={t['download.cv']}
      data-online={t['contact.screenOnline']}
      data-visitors={t['contact.screenVisitors']}
      data-stats={stats ? 'true' : undefined}
      data-locale={LOCALE_TAGS[locale]}
    >
      <figcaption class="laptop-caption text-sm text-ink-muted">
        <!-- A surface pill keeps the contrast where the laptop's shadow falls. -->
        <span class="inline-block rounded-full bg-surface px-3 py-1">{t['contact.homelab']}</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  /*
   * The laptop stands on the room's floor (ADR 0020), drawn by the camera beside the copy (wide
   * screens) or above it (phones); the band holds its data, and its caption follows the copy.
   */
  @media (min-width: 1024px) {
    /*
     * The copy stays left of the laptop and within the scrim: the column is capped by the screen width,
     * the e-mail address a little smaller so it fits on one line, and the Copy button goes below it.
     */
    :root[data-room-3d] .contact-grid {
      grid-template-columns: minmax(0, min(40rem, 44vw));
      gap: 1.5rem;
    }

    :root[data-room-3d] .contact-grid a[data-outbound='email'] {
      font-size: clamp(1.25rem, 2.4vw, 2rem);
    }

    :root[data-room-3d] .contact-grid p:has(> a[data-outbound='email']) {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const label = button.querySelector<HTMLElement>('[data-copy-label]');
    const original = label?.textContent ?? '';
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset['copy'] ?? '');
        if (label) label.textContent = button.dataset['labelCopied'] ?? original;
        setTimeout(() => label && (label.textContent = original), 2000);
      } catch {
        // Clipboard blocked: the mailto link next to the button still works.
      }
    });
  }
</script>
