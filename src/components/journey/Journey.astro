---
/**
 * Journey section (docs/03-design-system.md §5). The <ol> is the timeline in every mode; with the
 * room (ADR 0019) a 3D thread runs through a bead beside each card (src/scenes/room/parts/journey.ts)
 * and marks the cards it has reached. The stage height is fixed, so nothing shifts when it starts.
 */
import MilestoneDetail from './MilestoneDetail.astro';
import { localize, stripEmphasis, type Milestone, type MilestoneSource, type Profile } from '@/lib/content';
import { type Locale, UI } from '@/lib/i18n';

interface Props {
  locale: Locale;
  copy: Profile['journey'];
  entries: { milestone: Milestone; source: MilestoneSource | null }[];
}

const { locale, copy, entries } = Astro.props;
const t = UI[locale];
const title = stripEmphasis(localize(copy.title, locale));
---

<section id="journey" aria-labelledby="journey-title" class="scroll-mt-20">
  <div class="mx-auto grid max-w-[1120px] items-center gap-10 px-[clamp(16px,4vw,40px)] py-16 lg:grid-cols-[0.8fr_1.2fr] lg:py-24">
    <div class="grid min-w-0 gap-4" data-journey-intro>
      <h2 id="journey-title" class="text-h2">
        {title}
      </h2>
      <p class="max-w-[42ch] text-ink-muted">{localize(copy.intro, locale)}</p>
    </div>

    <div
      class="journey-stage relative h-[480px] min-w-0 sm:h-[560px]"
      data-journey-stage
      data-count={entries.length}
    >
      <ol class="journey-list relative grid h-full content-center gap-5">
        {entries.map(({ milestone, source }) => {
          const popoverId = `milestone-${milestone.id}`;
          const label = (
            <>
              <span class="block text-xs font-semibold text-amber-deep tabular-nums">{milestone.year}</span>
              <span class="block font-semibold text-ink">{localize(milestone.title, locale)}</span>
              <span class="subtitle block text-xs text-ink-muted">
                {localize(milestone.subtitle, locale)}
              </span>
            </>
          );
          return (
            <li class="milestone" data-milestone data-reached="true">
              {source ? (
                <button type="button" popovertarget={popoverId} class="label text-left">
                  {label}
                  <span class="sr-only">: {t['journey.openDetail']}</span>
                </button>
              ) : (
                <div class="label">{label}</div>
              )}
              {source && (
                <MilestoneDetail id={popoverId} locale={locale} milestone={milestone} source={source} />
              )}
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<style>
  .label {
    display: block;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    padding: 0.5rem 0.75rem;
    line-height: 1.35;
    box-shadow: 0 8px 18px -12px color-mix(in srgb, var(--forest) 50%, transparent);
    transition: opacity 300ms ease;
  }

  button.label {
    cursor: pointer;
  }

  button.label:hover {
    border-color: var(--amber-deep);
  }

  /* Timeline (fallback): a vertical line with a dot per milestone. */
  .journey-list {
    padding-left: 1.75rem;
  }

  .journey-list::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0.5rem;
    width: 2px;
    height: calc(100% - 9rem);
    transform: translateY(-50%);
    background: var(--forest);
    opacity: 0.35;
  }

  .milestone {
    position: relative;
  }

  .milestone::before {
    content: '';
    position: absolute;
    top: 50%;
    left: -1.6rem;
    width: 0.85rem;
    height: 0.85rem;
    border: 3px solid var(--forest);
    border-radius: 999px;
    background: var(--amber);
    transform: translateY(-50%);
  }

  /*
   * With the room (ADR 0019) the 3D thread and its beads take the place of the line and the dots;
   * the cards stay where they are. Not reached yet: lighter card, same text colors (keeps contrast).
   */
  .journey-stage[data-room-ready] .journey-list::before,
  .journey-stage[data-room-ready] .milestone::before {
    display: none;
  }

  .journey-stage[data-room-ready] .milestone[data-reached='false'] .label {
    border-style: dashed;
    background: transparent;
    box-shadow: none;
  }
</style>
