---
/**
 * Journey section (docs/03-design-system.md §5). The <ol> is both the accessible timeline
 * (no JS / no WebGL) and, once the 3D path is ready, the set of labels placed beside its nodes.
 * The stage has a fixed height in both modes, so switching causes no layout shift.
 */
import MilestoneDetail from './MilestoneDetail.astro';
import {
  journeySpan,
  localize,
  splitEmphasis,
  type Milestone,
  type MilestoneSource,
  type Profile,
} from '@/lib/content';
import { type Locale, UI } from '@/lib/i18n';

interface Props {
  locale: Locale;
  copy: Profile['journey'];
  entries: { milestone: Milestone; source: MilestoneSource | null }[];
}

const { locale, copy, entries } = Astro.props;
const t = UI[locale];
const span = journeySpan(entries.map((entry) => entry.milestone));
const title = splitEmphasis(localize(copy.title, locale));
---

<section id="journey" aria-labelledby="journey-title" class="scroll-mt-20">
  <div class="mx-auto grid max-w-[1120px] items-center gap-10 px-[clamp(16px,4vw,40px)] py-16 lg:grid-cols-[0.8fr_1.2fr] lg:py-24">
    <div class="grid min-w-0 gap-4">
      <p class="font-mono text-eyebrow text-amber-deep uppercase">
        {t['journey.eyebrow']}
        {span && ` · ${span.from} → ${span.to}`}
      </p>
      <h2 id="journey-title" class="text-h2">
        {title.map((segment) =>
          segment.emphasis ? <span class="text-amber-deep">{segment.text}</span> : segment.text,
        )}
      </h2>
      <p class="max-w-[42ch] text-ink-muted">{localize(copy.intro, locale)}</p>
    </div>

    <div
      class="journey-stage relative h-[480px] min-w-0 sm:h-[560px]"
      data-journey-stage
      data-count={entries.length}
    >
      <canvas class="absolute inset-0 size-full opacity-0" aria-hidden="true"></canvas>
      <ol class="journey-list relative grid h-full content-center gap-5">
        {entries.map(({ milestone, source }) => {
          const popoverId = `milestone-${milestone.id}`;
          const label = (
            <>
              <span class="block font-mono text-[11px] font-medium text-amber-deep">{milestone.year}</span>
              <span class="block font-semibold text-ink">{localize(milestone.title, locale)}</span>
              <span class="subtitle block text-xs text-ink-muted">
                {localize(milestone.subtitle, locale)}
              </span>
            </>
          );
          return (
            <li class="milestone" data-milestone data-reached="true">
              {source ? (
                <button type="button" popovertarget={popoverId} class="label text-left">
                  {label}
                  <span class="sr-only">: {t['journey.openDetail']}</span>
                </button>
              ) : (
                <div class="label">{label}</div>
              )}
              {source && (
                <MilestoneDetail id={popoverId} locale={locale} milestone={milestone} source={source} />
              )}
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<style>
  .label {
    display: block;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    padding: 0.5rem 0.75rem;
    line-height: 1.35;
    box-shadow: 0 8px 18px -12px color-mix(in srgb, var(--forest) 50%, transparent);
    transition: opacity 300ms ease;
  }

  button.label {
    cursor: pointer;
  }

  button.label:hover {
    border-color: var(--amber-deep);
  }

  /* Timeline (fallback): a vertical line with a dot per milestone. */
  .journey-list {
    padding-left: 1.75rem;
  }

  .journey-list::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0.5rem;
    width: 2px;
    height: calc(100% - 9rem);
    transform: translateY(-50%);
    background: var(--forest);
    opacity: 0.35;
  }

  .milestone {
    position: relative;
  }

  .milestone::before {
    content: '';
    position: absolute;
    top: 50%;
    left: -1.6rem;
    width: 0.85rem;
    height: 0.85rem;
    border: 3px solid var(--forest);
    border-radius: 999px;
    background: var(--amber);
    transform: translateY(-50%);
  }

  .journey-stage canvas {
    transition: opacity 400ms ease;
  }

  /* 3D layout: the same list items become labels positioned beside each node by the script. */
  .journey-stage[data-scene-ready] canvas {
    opacity: 1;
  }

  .journey-stage[data-scene-ready] .journey-list {
    position: absolute;
    inset: 0;
    display: block;
    padding: 0;
  }

  .journey-stage[data-scene-ready] .journey-list::before,
  .journey-stage[data-scene-ready] .milestone::before {
    display: none;
  }

  .journey-stage[data-scene-ready] .milestone {
    position: absolute;
    top: 0;
    left: 0;
    max-width: calc(100% - var(--x, 0px) - 1.5rem);
    transform: translate(calc(var(--x, 0px) + 1.4rem), calc(var(--y, 0px) - 50%));
  }

  /* Not reached yet: lighter card, same text colors (keeps WCAG contrast, unlike opacity). */
  .journey-stage[data-scene-ready] .milestone[data-reached='false'] .label {
    border-style: dashed;
    background: transparent;
    box-shadow: none;
  }

  @media (max-width: 639px) {
    .journey-stage[data-scene-ready] .subtitle {
      display: none;
    }
  }
</style>

<script>
  import { decide3D, detectCapabilities } from '@/scenes/core/capabilities';
  import { sectionProgress } from '@/scenes/journey-path/layout';

  async function start(): Promise<void> {
    const stage = document.querySelector<HTMLElement>('[data-journey-stage]');
    const section = stage?.closest('section');
    const canvas = stage?.querySelector('canvas');
    const items = stage ? [...stage.querySelectorAll<HTMLElement>('[data-milestone]')] : [];
    if (!stage || !section || !canvas || items.length < 2) return;

    const decision = decide3D(detectCapabilities());
    if (decision.mode === 'off') {
      stage.dataset['scene'] = 'off';
      return;
    }

    let progress = 0;
    const measure = (): void => {
      const rect = section.getBoundingClientRect();
      const atPageEnd = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
      progress = sectionProgress(rect.top, rect.height, window.innerHeight, atPageEnd);
    };
    measure();
    window.addEventListener('scroll', measure, { passive: true });
    window.addEventListener('resize', measure, { passive: true });

    const [{ mountScene }, { createJourneyPath }] = await Promise.all([
      import('@/scenes/core/mount'),
      import('@/scenes/journey-path'),
    ]);
    mountScene({
      stage,
      canvas,
      decision,
      create: (setup) =>
        createJourneyPath(setup, {
          count: items.length,
          getProgress: () => progress,
          onProject: (nodes) => {
            nodes.forEach((node, index) => {
              const item = items[index];
              if (!item) return;
              item.style.setProperty('--x', `${node.x.toFixed(1)}px`);
              item.style.setProperty('--y', `${node.y.toFixed(1)}px`);
              item.dataset['reached'] = String(node.reached);
            });
          },
        }),
    });
  }

  // The section is below the fold: build the scene only when the visitor scrolls near it, so its
  // setup (WebGL context, shaders, first frame) never competes with the first screen.
  function startWhenNear(): void {
    const stage = document.querySelector<HTMLElement>('[data-journey-stage]');
    if (!stage) return;
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        void start();
      },
      { rootMargin: '50% 0px' },
    );
    observer.observe(stage);
  }

  if (document.readyState === 'complete') startWhenNear();
  else window.addEventListener('load', startWhenNear, { once: true });
</script>
